# 页面标题
VITE_APP_TITLE = 智慧交管拥堵治理预警监控平台

# 生产环境配置
VITE_APP_ENV = 'production'

# 接口基地址（默认取 location.origin，经 nginx.conf 反向代理到后端容器 backend:8000，与 bak 一致）。
# REST(/api/)、静态运维页(/static/)、实时推送(/ws) 三条 location 全部由 nginx.conf 代理，前端只发同源请求。
# 仅当后端跨域部署（非同源）时，才需要显式指定，例如：
# VITE_API_BASE = 'http://172.16.168.9:8000'
# 注意：切勿写成 http://localhost:8000——该值会被 Vite 静态内联进 dist，
# 远程浏览器会把它解析成「访问者本机」的 8000 端口，导致异地访问全部失败。
# AI 分析服务（8001）不对前端开放（v0.11.0），前端不连接，故无需配置。

# 离线地图瓦片（同源路径，由 nginx.conf 的 location /tiles/ 静态服务；
# 未挂载宿主目录时回退镜像内 dist/tiles）
VITE_TILE_URL = '/tiles/{z}/{x}/{y}.png'
VITE_TILE_URL_DARK = '/tiles/{z}/{x}/{y}.png'
