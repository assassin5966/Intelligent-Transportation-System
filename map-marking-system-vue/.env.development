# 页面标题
VITE_APP_TITLE = 智慧交管拥堵治理预警监控平台

# 开发环境配置
VITE_APP_ENV = 'development'

# 接口基地址（默认取 location.origin，由 vite.config.js 的 server.proxy 转发到本地后端 8000，
# 与生产环境 nginx.conf 的代理路径保持一一对应：/api、/static、/ws）。
# 注意：切勿写成 http://localhost:8000，否则代理失效，用局域网 IP 访问时请求会打到访问者本机。
# 仅当后端跨域部署（非同源）时，才需要显式指定，例如：
# VITE_API_BASE = 'http://172.16.168.9:8000'
# AI 分析服务（8001）不对前端开放（v0.11.0），前端不连接，故无需配置。

# 离线地图瓦片（同源路径，开发时由 Vite dev 静态服务 public/tiles）
# 切换暗色主题时复用同一组瓦片（深色用 VITE_TILE_URL_DARK，未配置时回退 VITE_TILE_URL）
VITE_TILE_URL = '/tiles/{z}/{x}/{y}.png'
VITE_TILE_URL_DARK = '/tiles/{z}/{x}/{y}.png'
