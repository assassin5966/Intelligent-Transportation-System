# 环境变量示例 (复制为 .env 后按需修改)
# Redis
REDIS_URL=redis://redis:6379/0
# 服务间通信
BACKEND_URL=http://backend:8000
AI_SERVICE_URL=http://ai:8001
# 端口
BACKEND_PORT=8000
AI_PORT=8001
# AI 视觉分析
YOLO_MODEL=models/yolo11n.pt
YOLO_CONF=0.4
YOLO_IOU=0.5
# 时序预测
CHRONOS_MODEL=amazon/chronos-t5-tiny
PREDICTION_HORIZON=60
PREDICTION_HISTORY_HOURS=168
# 告警规则
RULES_FILE=configs/rules.yaml
