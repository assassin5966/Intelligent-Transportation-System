# 环境变量示例 (复制为 .env 后按需修改)
# Redis
REDIS_URL=redis://redis:6379/0
# 服务间通信
BACKEND_URL=http://backend:8000
AI_SERVICE_URL=http://ai:8001
# 端口
BACKEND_PORT=8000
AI_PORT=8001
# AI 视觉分析
YOLO_MODEL=models/yolo11n.pt
YOLO_CONF=0.4
YOLO_IOU=0.5
# 时序预测
CHRONOS_MODEL=models
PREDICTION_HORIZON=60
PREDICTION_HISTORY_HOURS=168
# 告警规则
RULES_FILE=configs/rules.yaml
# CORS 允许的跨域来源 (逗号分隔; 生产环境应改为具体前端域名, 如 https://screen.example.com)
CORS_ORIGINS=*
# WVP-GB28181 对接 (关闭则设备靠手填 stream_url 注册)
WVP_ENABLED=false
WVP_API_URL=http://wvp:18080
WVP_USERNAME=admin
WVP_PASSWORD=admin
WVP_SYNC_INTERVAL=30
WVP_PLAY_PROTOCOL=flv
WVP_STREAM_SUB=true
