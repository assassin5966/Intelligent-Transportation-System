# 环境变量示例 (复制为 .env 后按需修改)
# Redis
REDIS_URL=redis://redis:6379/0
# MySQL 长期归档 (小时级车流/人流量落库, 长期报表; 由 docker-compose 提供 mysql 服务)
# 关闭(MySQL_ENABLED=false)则跳过归档, 小时数据仅存 Redis(默认保留30天)
MYSQL_ENABLED=true
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root123456
MYSQL_DATABASE=dt_stats
# 归档调度周期(秒), 只归档"已完成小时"的数据; 停机后重启会自动补归档
ARCHIVE_INTERVAL_SECONDS=300
# MySQL 长期保留天数 (定期自动清理更早数据)
MYSQL_RETENTION_DAYS=365
# 服务间通信
BACKEND_URL=http://backend:8000
AI_SERVICE_URL=http://ai:8001
# 端口
BACKEND_PORT=8000
AI_PORT=8001
# AI 视觉分析
YOLO_MODEL=models/yolo11n.pt
YOLO_CONF=0.4
YOLO_IOU=0.5
# 时序预测
CHRONOS_MODEL=models
# 告警规则
RULES_FILE=configs/rules.yaml
# 业务规则集中配置 (计数/告警/拥挤/警力/预测/异常/跟踪, 修改后热重载无需重启)
BUSINESS_RULES_FILE=configs/business_rules.yaml
# 警力分配初始配置 (区域+总警力, 后端启动时写入 Redis; 仅新增不覆盖 API 配置)
POLICE_CONFIG_FILE=configs/police.yaml
# CORS 允许的跨域来源 (逗号分隔; 生产环境应改为具体前端域名, 如 https://screen.example.com)
CORS_ORIGINS=*
# WVP-GB28181 对接 (WVP/ZLM 已外部部署, 本项目仅作消费方)
# 关闭(WVP_ENABLED=false)则设备靠手填 stream_url 注册; 开启则后端自动同步外部 WVP 设备并刷新流地址
WVP_ENABLED=false
# ⚠️ 必改: 指向已部署的上级 WVP 管理地址 (REST API), 不可用容器名 wvp
WVP_API_URL=http://192.168.1.200:18080
# 上级 WVP 后台账号密码 (按实际部署填写)
WVP_USERNAME=admin
WVP_PASSWORD=admin
# 设备同步间隔(秒)
WVP_SYNC_INTERVAL=30
# AI 拉流协议: flv(默认) / rtsp
WVP_PLAY_PROTOCOL=flv
# 拉子码流降低推理压力 (true=子码流, false=主码流)
WVP_STREAM_SUB=true

# ---- 前端播放地址 (/api/devices/glm-5.3_common/play) ----
# ZLM 对外 FLV 地址前缀 (WVP 设备播放用; 空则原样返回 WVP 给的地址)
ZLM_PUBLIC_BASE=
# MediaMTX 对外地址 (RTSP 测试流播放用; 空则自动按请求 Host:8888 推导)
MEDIAMTX_PUBLIC_BASE=
