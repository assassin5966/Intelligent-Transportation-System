# 1080P 计数准确率试验组合，供已验证当前工作区代码的隔离/灰度环境使用。
# 仅当作为额外 --env-file 传给 GPU Compose 时生效，不会自动改变现有运行配置。
# 可在现场原有 .env.gpu 后追加：
# docker compose --env-file .env.gpu --env-file configs/1080p-count-accuracy-trial.env.example -f docker-compose.gpu.yml config --quiet
# 当前 shell 已导出的同名变量优先于这两个文件，须核实生效值。
# scripts/start_all_gpu.sh 只加载 .env.gpu；直接使用该脚本不会加载本试验文件。
#
# configs/business_rules.yaml 中 inference.imgsz 与 inference.decode_max_fps
# 会覆盖下面两个环境变量：试验前必须确认分别为 960 和 8。
# grid 仅对 FFmpeg 后端生效；无源 PTS 时保留输入帧，且可能短时突发。

INFER_MODE=gpu_batch
INFER_ENGINES_PER_GPU=1
INFER_HALF=true
INFER_IMGSZ=960
INFER_BATCH_TIMEOUT_MS=40
DECODE_BACKEND=ffmpeg
DECODE_MAX_SHORT_SIDE=540
DECODE_MAX_FPS=8
DECODE_FPS_SAMPLING=grid
