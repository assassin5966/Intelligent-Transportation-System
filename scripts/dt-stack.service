# ============================================================
# 智慧古城车辆人流监管平台 - 开机自启 systemd 单元
#
# 作用: 宿主机 reboot 后, 待 docker.service 就绪即拉起整套服务
#       (WVP 套 + 业务套 + 大屏前端, 走 start_all_gpu.sh)。
#       配合容器内 restart: always/unless-stopped 与脚本的 detect-and-start
#       幂等逻辑 (见 PROJECT_OPTIMIZATION_PLAN.md 2.3 / 2.4), 实现"重启自愈"。
#
# 部署 (在目标 Linux 服务器以 root 执行):
#   cp scripts/dt-stack.service /etc/systemd/system/dt-stack.service
#   # 若项目部署根目录不是 /opt/smart-transport, 改下方 ExecStart 路径
#   systemctl daemon-reload
#   systemctl enable --now dt-stack.service
#
# 查看状态 / 日志:
#   systemctl status dt-stack.service
#   journalctl -u dt-stack.service -f
#
# 说明:
#   - Type=oneshot + RemainAfterExit=yes: ExecStart 跑完(脚本前台执行到结束)即视为 active,
#     适合"启动一堆容器后退出"的一键脚本; 容器本身的持续运行由 docker restart policy 保证。
#   - 默认启用 GPU 版启动脚本 (目标机 10.10.10.11)。若部署的是 CPU 版服务器,
#     将 ExecStart 末端的 start_all_gpu.sh 改为 start_all.sh 即可 (同机两套 compose 同名 dt, 勿混跑)。
#   - RequiresMountsFor: 若镜像 tar / 权重 / 前端 dist 在独立挂载盘, 加此行确保挂载就绪后再启动。
# ============================================================

[Unit]
Description=Smart Transport Platform Stack (WVP + business backend + frontend)
After=docker.service docker.socket
Wants=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=600
# 等待 docker daemon 真正可用 (部分系统 socket 激活后 daemon 仍短暂未就绪)
ExecStartPre=/bin/sh -c 'until docker info >/dev/null 2>&1; do sleep 2; done'
# 用绝对路径; 若部署根目录不同, 修改此处
ExecStart=/bin/bash /opt/smart-transport/scripts/start_all_gpu.sh
# 可选: CPU 版服务器改为下一行
# ExecStart=/bin/bash /opt/smart-transport/scripts/start_all.sh

[Install]
WantedBy=multi-user.target
